# Customer service chat: SERVER-ONLY. Never use a VITE_ prefix for secrets.
# Set in Vercel Project Settings > Environment Variables, then redeploy.
# Empty key keeps the explicitly labelled showroom help mode available.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# VITE_API_BASE_URL: Optional. Connect the SPA to the separate Next.js+Prisma
# backend (backend/). Example: https://your-backend.example.com
# When set, the SPA can use safe endpoints (GET /api/health,
# GET /api/catalog/bikewale) and the admin Settings tab shows connectivity.
# The backend must allow this SPA's origin via CORS_ORIGINS.
# Leave unset to run the showroom in standalone (in-browser) mode.
VITE_API_BASE_URL=

