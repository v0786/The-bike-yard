# The Bike Yard — Environment variables (placeholders only)
#
# Copy this file to `.env.local` and replace each placeholder with a value
# appropriate for your environment. Secret values are never committed.
#
# See docs/SETUP.md for full setup instructions.

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Trusted auth hosts
NEXT_PRIVATE_AUTH_TRUSTED_HOSTS=localhost

# Database (PostgreSQL) — replace USER, PASSWORD, HOST, PORT, DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Authentication (Auth.js / NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-must-be-at-least-32-characters
