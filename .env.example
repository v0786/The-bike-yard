# The Bike Yard — Environment variables (placeholders only)
#
# Copy this file to `.env.local` and replace each placeholder with a value
# appropriate for your environment. Secret values are never committed.
#
# See docs/SETUP.md for full setup instructions.

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Trusted auth hosts
NEXT_PRIVATE_AUTH_TRUSTED_HOSTS=localhost

# Database (PostgreSQL) — replace USER, PASSWORD, HOST, PORT, DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Authentication (Auth.js / NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-must-be-at-least-32-characters

# Motorcycle Data Integration Engine
# Secret that authorises the scheduled synchronisation endpoint (/api/cron/bike-sync).
# Vercel Cron sends this as an `Authorization: Bearer <CRON_SECRET>` header.
CRON_SECRET=your-cron-secret-here

# Development/test fixture provider (NEVER enable in production).
BIKE_PROVIDER_MOCK_ENABLED=false

# Synchronisation tuning (optional).
BIKE_SYNC_MAX_RETRIES=3
BIKE_SYNC_RETRY_BASE_MS=250
BIKE_PROVIDER_RATE_LIMIT_PER_MINUTE=60

# BikeWale official API — PENDING AUTHORISED ACCESS. Do not invent values.
# Leave blank until a commercial agreement provides the documented endpoint + key.
BIKEWALE_API_BASE_URL=
BIKEWALE_API_KEY=
BIKEWALE_API_CATALOG_PATH=
