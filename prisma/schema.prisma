model Document {
  id            String @id @default(uuid()) @db.Uuid
  customerId    String? @db.Uuid
  saleId        String? @db.Uuid
  financeApplicationId String? @db.Uuid
  insuranceApplicationId String? @db.Uuid
  rtoApplicationId String? @db.Uuid
  documentType  String
  fileName      String
  storageKey    String
  mimeType      String
