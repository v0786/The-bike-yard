// -------------------
// Core Models
// -------------------

model Dealership {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  address     String?
  gstin       String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                String @id @default(uuid()) @db.Uuid
  email             String @unique
  password          String
  name              String?
  role              String
  dealershipId      String? @db.Uuid
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StaffTask {
  id            String @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  assignedTo    String @db.Uuid
  creator       String @db.Uuid
  status        StaffTaskStatus @default(open)
  priority      String   @default("normal")
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id            String @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String @db.Uuid
  action        String
  oldValues     Json?
  newValues     Json?
  userId        String @db.Uuid
  ipAddress     String?
  timestamp     DateTime @default(now())
}

// -------------------
// Catalogue Models
// -------------------

model Brand {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Model {
  id          String @id @default(uuid()) @db.Uuid
  brandId     String @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, name])
}

model Variant {
  id              String @id @default(uuid()) @db.Uuid
  modelId         String @db.Uuid
  colourId        String @db.Uuid
  engineCC        Int?
  mileage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([modelId, engineCC])
}

model Colour {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  hexCode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------
// Stock Unit (physical motorcycle)
// -------------------

model StockUnit {
  id               String @id @default(uuid()) @db.Uuid
  chassisNumber    String @unique
  engineNumber     String @unique
  variantId        String @db.Uuid
  colourId         String? @db.Uuid
  dealershipId     String? @db.Uuid
  purchasePrice    BigInt
  purchaseInvoiceNumber String?
  receivedDate     DateTime?
  currentStatus    StockUnitStatus @default(available)
  location         String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

}

// -------------------
// Reservation / Booking
// -------------------

model Reservation {
  id           String @id @default(uuid()) @db.Uuid
  stockUnitId  String @db.Uuid
  customerId   String @db.Uuid
  bookingId    String? @db.Uuid
  reservedAt   DateTime @default(now())
  expiresAt    DateTime?
  releasedAt   DateTime?
  status       ReservationStatus @default(active)

  @@index([stockUnitId, status], name: "reservation_active_unit_idx")
}

// -------------------
// Booking (advance payment record)
// -------------------

model Booking {
  id            String @id @default(uuid()) @db.Uuid
  customerId    String @db.Uuid
  stockUnitId   String? @db.Uuid
  bookingNumber String @unique
  advanceAmount BigInt
  advanceStatus String   @default("pending") // pending/confirmed/delivered/cancelled
  confirmedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([stockUnitId])
}

// -------------------
// Sale
// -------------------

model Sale {
  id            String @id @default(uuid()) @db.Uuid
  customerId    String @db.Uuid
  stockUnitId   String @db.Uuid
  bookingId     String? @db.Uuid
  saleNumber    String @unique
  exShowroomPrice BigInt
  onRoadPrice   BigInt
  discount      BigInt   @default(0)
  finalSellingPrice BigInt
  gstAmount     BigInt
  cgstAmount    BigInt
  sgstAmount    BigInt
  igstAmount    BigInt
  placeOfSupply String?
  hsnCode       String?
  gstRate       Int      // basis points (e.g. 2800 = 28.00%)
  status        SaleStatus @default(pending)
  deliveryDate  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  @@index([stockUnitId])
}

// -------------------
// Payment
// -------------------

model Payment {
  id            String @id @default(uuid()) @db.Uuid
  customerId    String @db.Uuid
  saleId        String? @db.Uuid
  bookingId     String? @db.Uuid
  amount        BigInt
  method        String   // cash, upi, qr, bank, card, finance, partial
  referenceId   String?
  notes         String?
  status        PaymentStatus @default(pending)
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([saleId])
  @@index([bookingId])
  @@index([customerId])
}

// -------------------
// Payment Allocation (maps payment to sale or booking)
// -------------------

model PaymentAllocation {
  id            String @id @default(uuid()) @db.Uuid
  paymentId     String @db.Uuid
  saleId        String? @db.Uuid
  bookingId     String? @db.Uuid
  amount        BigInt
  allocatedAt   DateTime @default(now())

  @@unique([paymentId])
  @@index([paymentId])
  @@index([saleId])
  @@index([bookingId])

  // Exactly one of saleId or bookingId must be set
  // Enforced by: CHECK ((saleId IS NOT NULL) <> (bookingId IS NOT NULL))
}

// -------------------
// Invoice
// -------------------

model Invoice {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique
  saleId        String @db.Uuid
  type          String   // tax_invoice/sales_invoice
  subtotal      BigInt   // taxable value excluding GST
  gstAmount     BigInt   // total GST = cgst + sgst + igst
  cgstAmount    BigInt
  sgstAmount    BigInt
  igstAmount    BigInt
  total         BigInt   // subtotal + gstAmount
  gstRate       Int      // basis points at issue
  placeOfSupply String? // State code/name
  hsnCode       String?  // HSN/SAC code; owner/tax advisor to confirm
  gstin         String?  // Dealership GSTIN snapshot
  customerGstin String? // Customer GSTIN (if B2B)
  issuedAt      DateTime @default(now())
  dueDate       DateTime?
  status        String   // issued/paid/void
  pdfUrl        String?
  createdBy     String @db.Uuid

  @@index([saleId])
  @@index([status])

  // Tax split rule: intra-state → cgst = sgst = gst/2, igst = 0
  //               inter-state → igst = gst, cgst = sgst = 0
  // Enforced by: CHECK (gstAmount = cgstAmount + sgstAmount + igstAmount)
}

// -------------------
// Refund
// -------------------

model Refund {
  id            String @id @default(uuid()) @db.Uuid
  refundNumber  String @unique
  paymentId     String @db.Uuid
  saleId        String? @db.Uuid
  bookingId     String? @db.Uuid
  amount        BigInt   // must not exceed unrefunded payment amount
  reason        String   // required free-text reason
  status        RefundStatus @default(pending) // pending/approved/completed/rejected
  requestedBy   String @db.Uuid
  approvedBy    String? @db.Uuid
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([paymentId])
  @@index([status])

  // Lifecycle: pending → approved → completed, or pending → rejected
  // Only an approved refund may be completed
  // Requester cannot self-approve: enforced by APP logic (approvedBy ≠ requestedBy where policy requires)
}

