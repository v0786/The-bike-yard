# The Bike Yard — .gitignore
# Never commit environment files containing real secrets.
.env
.env.local
.env.development.local
.env.test
.env.test.local
.env.production.local
*.env

# Example file with placeholders only is safe to commit
# (!.env.example)

# Dependencies
node_modules/

# Next.js / build output
.next/
dist/
out/
build/

# TypeScript build cache
*.tsbuildinfo

# IDE / editor personal settings
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Redundant archive of docs/ (do not duplicate committed documentation)
docs.zip

# Prisma generated/migrations (generated artifacts; schema.prisma is committed)
prisma/migrations/
prisma/dev.db

# Test artifacts (generated reports/screenshots — never commit)
playwright-report/
test-results/
blob-report/
coverage/
.playwright/
