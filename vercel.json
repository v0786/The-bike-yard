{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [{ "source": "/api/bike-search", "destination": "/api/bike-search" }, { "source": "/api/customer-chat", "destination": "/api/customer-chat" }, { "source": "/(.*)", "destination": "/index.html" }]
}
